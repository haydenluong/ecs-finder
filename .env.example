# Copy this file to `.env` and fill in the real values.
# Supabase dashboard → Project Settings → API

# Public project URL. Safe to expose — it's just an address.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. Compiled into the browser bundle by design.
# Row Level Security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service role key — used ONLY by scripts/seed.ts and, later, the submission
# Route Handler. It bypasses Row Level Security entirely.
# Never give this one a NEXT_PUBLIC_ prefix: that would ship it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
